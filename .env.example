# Copy to .env. Every value has a working local default; hosted services are swapped in by
# changing these variables only. Never commit .env.

# --- API (FastAPI) ---------------------------------------------------------
DATABASE_URL=postgresql://finn:finn@localhost:5432/finn
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Public label for where the API runs (shown in /health).
FINN_ENV=local

# --- LLM providers (all OpenAI-compatible) ---------------------------------
# Local by default. Hosted keys are blank until accounts exist; the router
# skips any provider without a key.
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Web (Next.js) ---------------------------------------------------------
# Browser-visible base URL of the API. For phone testing on Wi-Fi use the
# laptop's LAN IP, e.g. http://192.168.1.20:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Milliseconds before the UI gives up on the API and renders the snapshot.
NEXT_PUBLIC_API_TIMEOUT_MS=4000

# Tier routing (provider:model, comma-separated fallback order). Local default uses an 8k-context
# variant of qwen2.5:7b: `ollama create qwen2.5-7b-8k -f ops/Modelfile.qwen2.5-7b-8k`.
# LLM_TIER_BULK=ollama:qwen2.5-7b-8k
# LLM_TIER_REASON=ollama:qwen2.5-7b-8k
